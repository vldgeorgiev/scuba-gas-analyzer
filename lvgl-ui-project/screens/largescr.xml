<screen permanent="true">
	<view extends="lv_obj" scrollable="false" clickable="true" style_pad_all="0">
		<screen_load_event screen="mainscr" trigger="clicked" />
		<column width="100%" height="100%" pad="#space_sm" gap="#space_sm" event_bubble="true">
			<row name="large_o2_row" width="100%" vertical_align="center" event_bubble="true">
				<h3 text="O2" width="52" />
				<h1 name="large_o2_value" text="" bind_text="main_o2_text" flex_grow="1" long_mode="dots" />
			</row>
			<row name="large_he_row" width="100%" vertical_align="center" event_bubble="true">
				<h3 text="He" width="52" />
				<h1 name="large_he_value" text="" bind_text="main_he_text" flex_grow="1" long_mode="dots" />
			</row>
			<row name="large_status" width="100%" vertical_align="center" event_bubble="true">
				<h4 text="CO" width="52" />
				<h4 name="large_co_value" bind_text="main_co_text" />
			</row>
		</column>
	</view>
</screen>
