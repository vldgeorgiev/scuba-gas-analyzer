<screen>
	<view extends="lv_obj" scrollable="false">
		<column width="100%" height="100%" pad="#space_sm" gap="#space_xs">
			<row width="100%" horizontal_align="space_between" vertical_align="center">
				<lv_label name="calibration_run_title" bind_text="calibration_run_title_text" long_mode="dots" />
				<lv_label name="calibration_current" bind_text="calibration_current_text" long_mode="dots" />
			</row>
			<lv_chart
				name="calibration_graph"
				width="100%"
				height="90"
				type="line"
				point_count="41"
				update_mode="shift"
				hor_div_line_count="3"
				ver_div_line_count="5"
			>
				<lv_chart-series color="#color_accent" axis="primary_y" />
				<lv_chart-axis axis="primary_y" min_value="0" max_value="100" />
			</lv_chart>
			<row width="100%" horizontal_align="space_between" vertical_align="center">
				<row gap="#space_xs" vertical_align="center">
					<lv_label name="calibration_stability" bind_text="calibration_stability_text" long_mode="dots" />
					<text text=" - " />
					<lv_label name="calibration_elapsed" bind_text="calibration_elapsed_text" long_mode="dots" />
				</row>
				<button name="calibration_cancel" text="Cancel" icon="icon_close" width="96" />
				<button name="calibration_done" text="Done" icon="icon_check" width="96" hidden="true" />
			</row>
		</column>
	</view>
</screen>
