<screen>
	<view extends="lv_obj" scrollable="false">
		<row width="100%" height="100%">
			<button name="calibration_back" text="" icon="icon_arrow_left">
				<screen_load_event screen="mainscr" trigger="clicked" />
			</button>
			<column name="calibration_list" grow="1" pad="#space_md" gap="#space_sm" scrollable="true">
				<h5 text="Calibration" />
				<row width="100%" horizontal_align="space_between" vertical_align="center">
					<text text="Calibrate air on start" />
					<switch name="startup_calibration" subject="calibration_on_start" />
				</row>
				<button name="calibrate_air" text="Air (20.9%)" icon="icon_refresh" width="100%" />
				<row width="100%" horizontal_align="space_between">
					<button name="calibrate_o2" text="O2 (100%)" icon="icon_refresh" width="49%" />
					<button name="clear_o2" text="Clear O2" icon="icon_trash" width="49%" />
				</row>
				<button name="calibrate_he" text="He (100%)" icon="icon_refresh" width="100%" />
				<lv_label name="calibration_result" bind_text="calibration_result_text" width="100%" long_mode="wrap" />
				<button name="open_diagnostics" text="Diagnostics" icon="icon_info" width="100%">
					<screen_create_event screen="diagnostics" trigger="clicked" />
				</button>
			</column>
		</row>
	</view>
</screen>
